# ── Supabase ──────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never exposed to the browser. Used for admin writes & webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# ── Paystack ──────────────────────────────────────────────
# Public key is safe in the browser. Secret key is SERVER-ONLY, never prefix with NEXT_PUBLIC_.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ── Site ──────────────────────────────────────────────────
# Used to build absolute callback URLs for Paystack. No trailing slash.
# Local: http://localhost:3000  ·  Preview: https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── WhatsApp / Contact ────────────────────────────────────
# Digits only, international format, no +, no spaces (e.g. 2348183650000)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348183650000
